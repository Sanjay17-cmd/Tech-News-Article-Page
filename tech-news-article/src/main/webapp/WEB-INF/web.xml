<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>2</session-timeout>
    </session-config>

    <listener>
        <listener-class>com.technews.listener.UserSessionListener</listener-class>
    </listener>

    <!-- stops the browser from caching protected pages, so Back after logout re-hits the server -->
    <filter>
        <filter-name>NoCacheFilter</filter-name>
        <filter-class>com.technews.filter.NoCacheFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>NoCacheFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet><servlet-name>LoginServlet</servlet-name><servlet-class>com.technews.servlet.LoginServlet</servlet-class></servlet>
    <servlet><servlet-name>DashboardServlet</servlet-name><servlet-class>com.technews.servlet.DashboardServlet</servlet-class></servlet>
    <servlet><servlet-name>ActiveUsersServlet</servlet-name><servlet-class>com.technews.servlet.ActiveUsersServlet</servlet-class></servlet>
    <servlet><servlet-name>LogoutServlet</servlet-name><servlet-class>com.technews.servlet.LogoutServlet</servlet-class></servlet>
    <servlet><servlet-name>DeleteCookieServlet</servlet-name><servlet-class>com.technews.servlet.DeleteCookieServlet</servlet-class></servlet>
    <servlet><servlet-name>PurchaseServlet</servlet-name><servlet-class>com.technews.servlet.PurchaseServlet</servlet-class></servlet>
    <servlet><servlet-name>DeleteSubscriptionServlet</servlet-name><servlet-class>com.technews.servlet.DeleteSubscriptionServlet</servlet-class></servlet>
    <servlet><servlet-name>AddFeedbackServlet</servlet-name><servlet-class>com.technews.servlet.AddFeedbackServlet</servlet-class></servlet>
    <servlet><servlet-name>FeedbackListServlet</servlet-name><servlet-class>com.technews.servlet.FeedbackListServlet</servlet-class></servlet>
    <servlet><servlet-name>FeedbackSummaryServlet</servlet-name><servlet-class>com.technews.servlet.FeedbackSummaryServlet</servlet-class></servlet>

    <servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>DashboardServlet</servlet-name><url-pattern>/dashboard</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ActiveUsersServlet</servlet-name><url-pattern>/active-users</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>LogoutServlet</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>DeleteCookieServlet</servlet-name><url-pattern>/delete-cookie</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>PurchaseServlet</servlet-name><url-pattern>/purchase</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>DeleteSubscriptionServlet</servlet-name><url-pattern>/delete-subscription</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>AddFeedbackServlet</servlet-name><url-pattern>/add-feedback</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FeedbackListServlet</servlet-name><url-pattern>/feedbacks</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>FeedbackSummaryServlet</servlet-name><url-pattern>/feedback-summary</url-pattern></servlet-mapping>

</web-app>
